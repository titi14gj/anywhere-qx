#!name=微信公众号去广告 (QX 转 Surge)
#!desc=由仓库中的 Quantumult X .snippet 自动转换；请查看文件末尾的兼容性注释
#!source=https://whatshub.top/rewrite/wechatad.conf

[Script]
wechat_official_accounts 0001 = type=http-response, pattern=^https?:\/\/mp\.weixin\.qq\.com\/mp\/getappmsgad, script-path=https://raw.githubusercontent.com/NobyDa/Script/master/QuantumultX/File/Wechat.js, requires-body=true, max-size=-1, timeout=30

[MITM]
hostname = %APPEND% mp.weixin.qq.com

