[URL Rewrite]
^https?:\/\/api\.blibee\.com\/cvsnotify-api\/cvs\/notify\/app\/banner\/v\d+$ - reject-200
^https?:\/\/ucmp\.sf-express\.com\/proxy\/operation-platform\/info-flow-adver\/query$ - reject-200

[Script]
wechat_applets 0003 = type=http-response, pattern=^(http|https):\/\/mp\.weixin\.qq\.com\/mp\/getappmsgad, script-path=https://raw.githubusercontent.com/titi14gj/anywhere-qx/main/surge/scripts/qx_body_replace.js, requires-body=true, max-size=-1, timeout=10, argument=eyJzZWFyY2giOiJhZHZlcnRpc2VtZW50IiwicmVwbGFjZW1lbnQiOiJkZGdrc2YyMDEzIn0
wechat_applets 0004 = type=http-response, pattern=^https?:\/\/wx\.mygolbs\.com\/WxBusServer\/ApiData\.do, script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/zhangshanggongjiao.js, requires-body=true, max-size=-1, timeout=30
wechat_applets 0005 = type=http-response, pattern=^(https?://)?([a-zA-Z0-9]+(-[a-zA-Z0-9]+)*\.)+[a-zA-Z]{2,}(:\d+)?/wp-json/[a-zA-Z0-9_-]+/(mp\/)?v\d/posts, script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/applet.js, requires-body=true, max-size=-1, timeout=30

